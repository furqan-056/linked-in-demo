<div class="min-h-screen w-full flex items-center justify-center bg-slate-50 px-6">
  <div class="w-full max-w-md mx-auto bg-white p-10 rounded-3xl shadow-2xl shadow-slate-200">
    <h2 class="text-4xl font-black text-slate-900 mb-8 text-center tracking-tight">
      Welcome Back
    </h2>
    <div class="text-center mb-8">
      <div class="w-14 h-14 bg-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-blue-200">
        <span class="text-white font-black text-2xl">M</span>
      </div>
      <h2 class="text-4xl font-black text-slate-900 tracking-tight">
        Join <span class="text-blue-600">MiniJob</span>
      </h2>
      <p class="text-slate-500 mt-2 text-sm">
        Create your account and start your journey
      </p>
    </div>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-5">
        <%= f.label :email, class: "block text-sm font-bold text-slate-700 mb-2" %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'name@example.com', class: "w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" %>
      </div>
      <div class="mb-5">
        <%= f.label :password, class: "block text-sm font-bold text-slate-700 mb-2" %>
        <%= f.password_field :password, autocomplete: 'current-password', placeholder: '••••••••', class: "w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" %>
      </div>
      <div class="flex items-center justify-between mb-8">
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500" %>
            <%= f.label :remember_me, class: "ml-2 text-sm text-slate-600 font-medium" %>
          </div>
        <% end %>
      </div>
      <div>
        <%= f.submit 'Log in', class: "w-full bg-blue-600 text-white py-4 rounded-2xl font-bold text-lg hover:bg-blue-700 hover:-translate-y-1 active:scale-95 transition-all duration-300 shadow-xl shadow-blue-200 cursor-pointer" %>
      </div>
    <% end %>
    <div class="mt-8 pt-6 border-t border-slate-100 text-center text-sm text-slate-500">
      <div class="space-y-2">
        <%= render 'devise/shared/links' %>
      </div>
    </div>
  </div>
</div>
