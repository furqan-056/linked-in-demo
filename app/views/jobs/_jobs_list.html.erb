<%= turbo_frame_tag "jobs_list" do %>
  <% if jobs.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% jobs.each do |job| %>
        <div class="relative bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden transform transition duration-300 hover:-translate-y-2 hover:scale-105 hover:shadow-2xl group">
          <div class="p-6 flex flex-col justify-between h-full">
            <% status_colors = { "open" => "bg-green-100 text-green-800", "closed" => "bg-red-100 text-red-800", "paused" => "bg-yellow-100 text-yellow-800" } %>
            <div class="flex justify-between items-start mb-2">
              <h2 class="text-xl font-semibold text-gray-900 group-hover:text-blue-600 transition duration-200">
                <%= job.title %>
              </h2>
              <span class="px-3 py-1 rounded-full text-xs font-semibold <%= status_colors[job.status] || 'bg-gray-100 text-gray-800' %>">
                <%= job.status.titleize %>
              </span>
            </div>
            <p class="text-sm text-gray-500 mb-3">
              <strong>Company:</strong> <%= job.company.name %>
            </p>
            <p class="text-gray-600 text-sm leading-relaxed">
              <%= truncate(job.description, length: 120) %>
            </p>
            <div class="mt-6 flex justify-between items-center">
              <%= link_to "Show Details",
                  job_path(job),
                  data: { turbo_frame: "_top" },
                  class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition duration-200 shadow-sm" %>
              <% if job.open? && current_user.candidate? %>
                <span class="text-green-600 text-sm font-medium">
                  Available to Apply
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="mt-6 flex justify-center">
      <%= paginate jobs, remote: true %>
    </div>
  <% else %>
    <div class="text-center py-20">
      <h3 class="text-2xl font-semibold text-gray-700 mb-2">
        No Jobs Available
      </h3>
      <p class="text-gray-500">
        Please check back later.
      </p>
    </div>
  <% end %>
<% end %>
