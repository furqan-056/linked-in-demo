<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
  <h1 class="text-4xl font-extrabold mb-4">Job Listings</h1>
  <form method="get"
        action="<%= jobs_path %>"
        data-controller="job-search"
        data-job-search-target="form"
        data-action="input->job-search#debounce change->job-search#debounce"
        data-turbo-frame="jobs_list"
        class="bg-white p-6 rounded-2xl shadow mb-8 grid grid-cols-1 md:grid-cols-3 gap-4">

    <input type="text"
           name="query"
           value="<%= params[:query] %>"
           placeholder='Search jobs...'
           autofocus
           class="border rounded-lg px-3 py-2 w-full"
           data-job-search-target="input" />
    <div>
      <label class="slider">Min Salary: <span data-job-search-target="minSalaryLabel"><%= params[:min_salary] || 0 %></span></label>
      <input type="range"
             name="min_salary"
             min="0"
             max="1000000"
             step="500"
             value="<%= params[:min_salary] || 0 %>"
             class="w-full"
             data-job-search-target="minSalary"
             data-action="input->job-search#updateSliderLabels" />
    </div>
    <div>
      <label class="slider">Max Salary: <span data-job-search-target="maxSalaryLabel"><%= params[:max_salary] || 0 %></span></label>
      <input type="range"
             name="max_salary"
             min="0"
             max="1000000"
             step="500"
             value="<%= params[:max_salary] || 0 %>"
             class="w-full"
             data-job-search-target="maxSalary"
             data-action="input->job-search#updateSliderLabels" />
    </div>
    <div class="md:col-span-3 flex justify-end mt-2">
      <button type="button"
              class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg"
              data-action="job-search#resetFilters">
        Reset Filters
      </button>
    </div>

  </form>
</div>
<%= render "jobs_list", jobs: @jobs %>
